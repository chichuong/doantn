NODE_ENV=development
PORT=3000

# Neu dung DATABASE_URL thi co the bo qua DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_project_database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_project_database
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Tao secret rieng toi thieu 32 ky tu, khong commit file .env.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Manual bank transfer: configure your own account and publicly accessible QR image.
# No payment gateway is used; only a manager can confirm money actually received.
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_QR_IMAGE_URL=

# Optional trained Python service. Baseline remains available without Python.
FORECAST_SERVICE_URL=http://127.0.0.1:8001
FORECAST_SERVICE_TOKEN=
FORECAST_TIMEOUT_MS=30000

# Exact allowed Web origins, comma separated. Flutter native does not require CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# 0 = no automatic expiry. If enabled later, schedule db:expire-reservations -- --apply.
RESERVATION_TTL_MINUTES=0
