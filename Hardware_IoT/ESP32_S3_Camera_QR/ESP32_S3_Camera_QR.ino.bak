/*
 * ============================================================================
 * KARAT RETAIL - FIRMWARE QUÉT QR CODE CAMERA OV5640 & TRA CỨU BACKEND
 * Phần cứng: ESP32-S3 WROOM Dual Type-C (N16R8) + Cảm biến OV5640 5MP
 * Phiên bản: v1.1 - Nâng cấp bảo vệ bộ nhớ PSRAM & Logging chẩn đoán từng bước
 * ============================================================================
 *
 * CÁC ĐIỂM SỬA CHỮA VÀ BẢO VỆ CHỐNG CRASH:
 * 1. Cấp phát toàn bộ cấu trúc và buffer quirc (image, pixels, vars) trong 8MB PSRAM.
 * 2. Tách độc lập buffer pixels và image (QUIRC_PIXEL_ALIAS_IMAGE = 0), tránh ghi đè buffer.
 * 3. Kiểm tra con trỏ NULL và kiểm soát biên sao chép buffer (bound checking).
 * 4. Tách biệt kiến trúc: Task quét QR chỉ chụp và giải mã; luồng loop() xử lý
 *    kết nối mạng và HTTPClient tra cứu Backend. Không làm nghẽn hoặc tràn stack.
 * 5. Log chi tiết từng bước trên Serial để theo dõi trạng thái hệ thống.
 * ============================================================================
 */

#include <Arduino.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>

#include "esp_camera.h"
#include "quirc.h"
#include "camera_pins.h"
#include "config.h"

// Biến lưu trạng thái chống quét lặp (Debounce)
static String lastScannedCode = "";
static unsigned long lastScanTimestamp = 0;

// Thống kê hoạt động
static unsigned long totalFramesScanned = 0;
static unsigned long totalQRDetections = 0;

// Hàng đợi truyền tin giữa Task quét QR và Main Loop
#define MAX_QR_PAYLOAD_LEN  1024
static volatile bool hasPendingQR = false;
static char pendingQRBuffer[MAX_QR_PAYLOAD_LEN + 1] = {0};

// Khai báo các hàm chức năng
void printBanner();
void checkPSRAM();
bool initCamera();
void connectWiFi();
void qrScannerTask(void *pvParameters);
void processQRCode(const char *qrPayload);
bool isValidKaratWarehouseFormat(const String &code);
void queryBackendDocument(const String &identifier);
String urlEncode(const String &str);

// ============================================================================
// SETUP CHÍNH CỦA ARDUINO
// ============================================================================
void setup() {
  Serial.begin(115200);
  delay(1500);

  printBanner();
  checkPSRAM();

  // 1. Khởi tạo Camera OV5640 ở định dạng Grayscale
  Serial.println("[BƯỚC 1] Đang khởi tạo camera OV5640...");
  if (!initCamera()) {
    Serial.println("[STOP] Camera khởi tạo thất bại. Vui lòng kiểm tra lại cáp FPC.");
    while (true) {
      delay(1000);
    }
  }
  Serial.println("[BƯỚC 1][OK] Camera OV5640 đã sẵn sàng.");

  // 2. Kết nối Wi-Fi 2.4GHz
  Serial.println("[BƯỚC 2] Đang kết nối mạng Wi-Fi...");
  connectWiFi();

  // 3. Khởi tạo FreeRTOS Task chạy giải mã QR trên Core 1 với Stack 32KB
  Serial.println("[BƯỚC 3] Khởi động FreeRTOS Task giải mã QR trên Core 1 (Stack: 32KB)...");
  BaseType_t taskCreated = xTaskCreatePinnedToCore(
    qrScannerTask,       // Hàm thực thi task
    "QR_Scan_Task",      // Tên task
    32 * 1024,           // Kích thước Stack (32KB an toàn cho tính toán ma trận)
    NULL,                // Tham số truyền vào
    1,                   // Mức ưu tiên vừa phải (không chiếm dụng IDLE task)
    NULL,                // Con trỏ quản lý task
    1                    // Ghim cố định vào Core 1
  );

  if (taskCreated != pdPASS) {
    Serial.println("[TASK][FAIL] Không thể tạo FreeRTOS Task quét QR!");
  } else {
    Serial.println("[TASK][OK] Task quét QR đã khởi chạy thành công.");
  }

  Serial.println("============================================================");
  Serial.println(" HỆ THỐNG ĐÃ SẴN SÀNG! ĐƯA MÃ QR VÀO TRƯỚC CAMERA ĐỂ QUÉT.");
  Serial.println(" Khoảng cách quét lý tưởng: 15 cm - 25 cm.");
  Serial.println("============================================================");
}

// ============================================================================
// LOOP CHÍNH: XỬ LÝ TRA CỨU BACKEND VÀ GIÁM SÁT KẾT NỐI MẠNG
// ============================================================================
void loop() {
  // 1. Kiểm tra nếu có mã QR vừa được nhận diện từ Task Core 1
  if (hasPendingQR) {
    char codeCopy[MAX_QR_PAYLOAD_LEN + 1];
    noInterrupts();
    strncpy(codeCopy, (const char *)pendingQRBuffer, sizeof(codeCopy) - 1);
    codeCopy[sizeof(codeCopy) - 1] = '\0';
    hasPendingQR = false;
    interrupts();

    Serial.printf("[LOOP] Nhận được mã từ Task: %s\n", codeCopy);
    processQRCode(codeCopy);
  }

  // 2. Giám sát tự động kết nối lại nếu Wi-Fi bị gián đoạn
  if (WiFi.status() != WL_CONNECTED) {
    static unsigned long lastReconnectTime = 0;
    if (millis() - lastReconnectTime > 10000) {
      lastReconnectTime = millis();
      Serial.println("[WIFI][RECONNECT] Đang thử kết nối lại Wi-Fi...");
      WiFi.reconnect();
    }
  }

  delay(50);
}

// ============================================================================
// BANNER VÀ KIỂM TRA BỘ NHỚ
// ============================================================================
void printBanner() {
  Serial.println();
  Serial.println("============================================================");
  Serial.println("  KARAT RETAIL - HỆ THỐNG QUÉT QR PHIẾU KHO ESP32-S3 (v1.1) ");
  Serial.printf("  Chip: ESP32-S3 | CPU: %d MHz | Flash: %u MB\n",
                ESP.getCpuFreqMHz(),
                (unsigned int)(ESP.getFlashChipSize() / (1024 * 1024)));
  Serial.println("============================================================");
}

void checkPSRAM() {
  if (psramFound()) {
    Serial.printf("[PSRAM] OK - Dung lượng: %u MB | Còn trống: %u KB\n",
                  (unsigned int)(ESP.getPsramSize() / (1024 * 1024)),
                  (unsigned int)(ESP.getFreePsram() / 1024));
  } else {
    Serial.println("[PSRAM][CẢNH BÁO] Không tìm thấy PSRAM!");
    Serial.println("Vui lòng vào Tools -> PSRAM: Chọn 'OPI PSRAM'.");
  }
}

// ============================================================================
// KHỞI TẠO CAMERA VỚI SƠ ĐỒ CHÂN ĐÃ XÁC THỰC
// ============================================================================
bool initCamera() {
  camera_config_t config = {};
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer   = LEDC_TIMER_0;

  // Giữ nguyên 100% sơ đồ chân đã chạy thành công
  config.pin_d0       = Y2_GPIO_NUM;
  config.pin_d1       = Y3_GPIO_NUM;
  config.pin_d2       = Y4_GPIO_NUM;
  config.pin_d3       = Y5_GPIO_NUM;
  config.pin_d4       = Y6_GPIO_NUM;
  config.pin_d5       = Y7_GPIO_NUM;
  config.pin_d6       = Y8_GPIO_NUM;
  config.pin_d7       = Y9_GPIO_NUM;

  config.pin_xclk     = XCLK_GPIO_NUM;
  config.pin_pclk     = PCLK_GPIO_NUM;
  config.pin_vsync    = VSYNC_GPIO_NUM;
  config.pin_href     = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn     = PWDN_GPIO_NUM;
  config.pin_reset    = RESET_GPIO_NUM;

  config.xclk_freq_hz = 20000000;
  // Dùng định dạng xám (Grayscale) cho engine giải mã quirc
  config.pixel_format = PIXFORMAT_GRAYSCALE;
  config.frame_size   = CAMERA_FRAME_SIZE;
  config.fb_count     = 2;
  config.fb_location  = CAMERA_FB_IN_PSRAM;
  config.grab_mode    = CAMERA_GRAB_LATEST;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("[CAMERA][FAIL] Lỗi esp_camera_init: 0x%x\n", err);
    return false;
  }

  sensor_t *s = esp_camera_sensor_get();
  if (s != nullptr) {
    Serial.printf("[CAMERA][OK] Cảm biến OV5640 PID: 0x%04X\n", s->id.PID);
    if (s->set_contrast)   s->set_contrast(s, 2);
    if (s->set_brightness) s->set_brightness(s, 0);
    if (s->set_saturation) s->set_saturation(s, -2);
    if (s->set_sharpness)  s->set_sharpness(s, 2);
    if (s->set_vflip)      s->set_vflip(s, 1); // Lật ảnh dọc đúng chiều
  }

  return true;
}

// ============================================================================
// KẾT NỐI WI-FI
// ============================================================================
void connectWiFi() {
  Serial.printf("[WIFI] Đang kết nối tới SSID: %s\n", WIFI_SSID);

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  int retries = 0;
  while (WiFi.status() != WL_CONNECTED && retries < (WIFI_TIMEOUT_SEC * 2)) {
    delay(500);
    Serial.print(".");
    retries++;
  }

  if (WiFi.status() == WL_CONNECTED) {
    Serial.println();
    Serial.println("[WIFI][OK] Kết nối Wi-Fi thành công!");
    Serial.printf("[WIFI] IP Address: %s\n", WiFi.localIP().toString().c_str());
    Serial.printf("[WIFI] Tín hiệu RSSI: %d dBm\n", WiFi.RSSI());
  } else {
    Serial.println();
    Serial.println("[WIFI][CẢNH BÁO] Kết nối Wi-Fi thất bại!");
    Serial.println("ESP32 vẫn quét QR nhưng không thể gửi request đến Backend.");
  }
}

// ============================================================================
// FREERTOS TASK: CHỤP ẢNH & GIẢI MÃ QR AN TOÀN TRÊN CORE 1
// ============================================================================
void qrScannerTask(void *pvParameters) {
  Serial.println("[QR_TASK] Task bắt đầu thực thi...");

  // 1. Khởi tạo cấu trúc quirc trong PSRAM
  struct quirc *q = quirc_new();
  if (!q) {
    Serial.println("[QR_TASK][LỖI NGHIÊM TRỌNG] quirc_new() trả về NULL (không đủ bộ nhớ)!");
    vTaskDelete(NULL);
    return;
  }
  Serial.printf("[QR_TASK] quirc_new() thành công, địa chỉ: %p\n", q);

  int lastW = 0, lastH = 0;
  unsigned long frameIndex = 0;

  while (true) {
    frameIndex++;

    // 2. Chụp frame từ camera
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) {
      if (frameIndex % 50 == 1) {
        Serial.println("[QR_TASK][WARN] Không nhận được frame từ camera.");
      }
      vTaskDelay(pdMS_TO_TICKS(50));
      continue;
    }

    totalFramesScanned++;

    // 3. Khởi tạo hoặc cập nhật kích thước bộ đệm quirc nếu cần
    if (fb->width != lastW || fb->height != lastH) {
      Serial.printf("[QR_TASK] Cập nhật kích thước bộ đệm: %dx%d (len=%u bytes)...\n",
                    fb->width, fb->height, fb->len);
      if (quirc_resize(q, fb->width, fb->height) < 0) {
        Serial.println("[QR_TASK][LỖI] quirc_resize() thất bại!");
        esp_camera_fb_return(fb);
        vTaskDelay(pdMS_TO_TICKS(100));
        continue;
      }
      lastW = fb->width;
      lastH = fb->height;
      Serial.printf("[QR_TASK] quirc_resize() thành công (image=%p, pixels=%p).\n",
                    q->image, q->pixels);
    }

    // 4. Lấy con trỏ buffer và kiểm tra an toàn
    int qw = 0, qh = 0;
    uint8_t *image = quirc_begin(q, &qw, &qh);
    if (!image) {
      Serial.println("[QR_TASK][ERR] quirc_begin() trả về con trỏ NULL!");
      esp_camera_fb_return(fb);
      vTaskDelay(pdMS_TO_TICKS(100));
      continue;
    }

    // 5. Sao chép an toàn với giới hạn kích thước (chống tràn buffer)
    size_t maxBufferBytes = (size_t)qw * (size_t)qh;
    size_t bytesToCopy = (fb->len < maxBufferBytes) ? fb->len : maxBufferBytes;
    memcpy(image, fb->buf, bytesToCopy);

    // 6. Trả ngay frame buffer cho driver camera trước khi tính toán giải mã
    esp_camera_fb_return(fb);
    fb = NULL;

    // 7. Nhận diện các hình vuông định vị (Finders & Capstones)
    quirc_end(q);

    // 8. Trích xuất và giải mã mã QR
    int numCodes = quirc_count(q);
    if (numCodes > 0) {
      Serial.printf("[QR_TASK] Phát hiện %d mã QR tiềm năng!\n", numCodes);
    }

    for (int i = 0; i < numCodes; i++) {
      struct quirc_code code;
      struct quirc_data data;

      quirc_extract(q, i, &code);
      quirc_decode_error_t err = quirc_decode(&code, &data);

      if (err == QUIRC_SUCCESS) {
        char payloadStr[MAX_QR_PAYLOAD_LEN + 1];
        int len = data.payload_len;
        if (len > MAX_QR_PAYLOAD_LEN) len = MAX_QR_PAYLOAD_LEN;
        memcpy(payloadStr, data.payload, len);
        payloadStr[len] = '\0';

        totalQRDetections++;
        Serial.printf("[QR_TASK][GIẢI MÃ THÀNH CÔNG] Nội dung: %s\n", payloadStr);

        // Chuyển kết quả sang Main Loop xử lý HTTP
        if (!hasPendingQR) {
          strncpy((char *)pendingQRBuffer, payloadStr, sizeof(pendingQRBuffer) - 1);
          pendingQRBuffer[sizeof(pendingQRBuffer) - 1] = '\0';
          hasPendingQR = true;
        }
      } else {
        // Chỉ in thông báo khi nhận diện capstone nhưng giải mã thất bại (do mờ hoặc lệch góc)
        // Serial.printf("[QR_TASK] Lỗi giải mã: %s\n", quirc_strerror(err));
      }
    }

    // Nghỉ nhẹ 80ms giữa các frame để hệ thống mát và nhường CPU cho Core 1 IDLE task
    vTaskDelay(pdMS_TO_TICKS(80));
  }

  quirc_destroy(q);
  vTaskDelete(NULL);
}

// ============================================================================
// XỬ LÝ MÃ QR TRÊN MAIN LOOP
// ============================================================================
void processQRCode(const char *qrPayload) {
  String code = String(qrPayload);
  code.trim();

  Serial.println();
  Serial.println("============================================================");
  Serial.printf("[QR PHÁT HIỆN] Mã nhận diện: %s\n", code.c_str());
  Serial.println("============================================================");

  // 1. Kiểm tra chống quét lặp (Debounce)
  unsigned long now = millis();
  if (code.equals(lastScannedCode) && (now - lastScanTimestamp < DEBOUNCE_DELAY_MS)) {
    Serial.printf("[DEBOUNCE] Bỏ qua mã trùng lặp trong %d giây: %s\n",
                  (DEBOUNCE_DELAY_MS / 1000), code.c_str());
    return;
  }

  // Cập nhật mốc thời gian và mã vừa quét
  lastScannedCode = code;
  lastScanTimestamp = now;

  // 2. Kiểm tra tính hợp lệ về định dạng của phiếu kho Karat Retail
  if (!isValidKaratWarehouseFormat(code)) {
    Serial.println("[KIỂM TRA ĐỊNH DẠNG] KHÔNG HỢP LỆ!");
    Serial.println("  Giải thích: Mã QR này không phải là phiếu kho Karat Retail.");
    Serial.println("  Định dạng hỗ trợ: 'DOC:WH-IN-*', 'DOC:WH-OUT-*', hoặc mã UUID phiếu kho.");
    return;
  }

  // 3. Gửi mã lên Backend để tra cứu trạng thái
  queryBackendDocument(code);
}

// ============================================================================
// BỘ LỌC ĐỊNH DẠNG MÃ PHIẾU KHO HỢP LỆ
// ============================================================================
bool isValidKaratWarehouseFormat(const String &code) {
  // 1. Mã QR tiêu chuẩn do hệ thống Karat Retail sinh ra: "DOC:WH-IN-..." hoặc "DOC:WH-OUT-..."
  if (code.startsWith("DOC:WH-IN-") || code.startsWith("DOC:WH-OUT-")) {
    return true;
  }

  // 2. Mã số phiếu trực tiếp: "WH-IN-..." hoặc "WH-OUT-..."
  if (code.startsWith("WH-IN-") || code.startsWith("WH-OUT-")) {
    return true;
  }

  // 3. Định dạng mã định danh UUID v4 chuẩn (36 ký tự)
  if (code.length() == 36 && code.charAt(8) == '-' && code.charAt(13) == '-' &&
      code.charAt(18) == '-' && code.charAt(23) == '-') {
    return true;
  }

  return false;
}

// ============================================================================
// GỌI API BACKEND NODE.JS TRA CỨU TRẠNG THÁI PHIẾU (CHẠY TRÊN MAIN LOOP)
// ============================================================================
void queryBackendDocument(const String &identifier) {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[BACKEND][LỖI] Không thể tra cứu do ESP32 chưa có kết nối Wi-Fi.");
    return;
  }

  HTTPClient http;
  http.setTimeout(HTTP_TIMEOUT_MS);

  // Xây dựng URL tra cứu: /api/v1/warehouse/documents/lookup?identifier=<encode>
  String url = "http://" + String(BACKEND_HOST) + ":" + String(BACKEND_PORT) +
               String(BACKEND_API_BASE) + "/warehouse/documents/lookup?identifier=" + urlEncode(identifier);

  Serial.printf("[HTTP] Đang gửi request tới Backend: %s\n", url.c_str());

  http.begin(url);
  http.addHeader("X-Device-Token", IOT_DEVICE_TOKEN);
  http.addHeader("Accept", "application/json");

  int httpCode = http.GET();
  Serial.printf("[HTTP] Mã phản hồi (HTTP Status): %d\n", httpCode);

  if (httpCode == HTTP_CODE_OK) { // HTTP 200
    String responseBody = http.getString();

    // Giải mã JSON trả về từ Backend (Tương thích cả ArduinoJson v6 lẫn v7)
#if defined(ARDUINOJSON_VERSION_MAJOR) && (ARDUINOJSON_VERSION_MAJOR >= 7)
    JsonDocument doc;
#else
    DynamicJsonDocument doc(4096);
#endif
    DeserializationError error = deserializeJson(doc, responseBody);

    if (error) {
      Serial.printf("[JSON][FAIL] Lỗi parse JSON từ Backend: %s\n", error.c_str());
      http.end();
      return;
    }

    JsonObject data = doc["data"];
    if (data.isNull()) {
      Serial.println("[JSON][WARN] Phản hồi không có trường dữ liệu 'data'.");
      http.end();
      return;
    }

    const char *docNumber = data["document_number"] | "N/A";
    const char *docType   = data["type"] | "N/A";
    const char *status    = data["status"] | "N/A";
    const char *whName    = data["warehouse_name"] | "Chưa xác định";
    JsonArray items       = data["items"];

    // In bảng kết quả chi tiết lên Serial Monitor
    Serial.println();
    Serial.println("+----------------------------------------------------------+");
    Serial.println("|          KẾT QUẢ TRA CỨU PHIẾU KHO KARAT RETAIL         |");
    Serial.println("+----------------------------------------------------------+");
    Serial.printf("| Mã phiếu      : %-40s |\n", docNumber);
    Serial.printf("| Loại phiếu    : %-40s |\n", (!strcmp(docType, "import") ? "NHẬP KHO" : "XUẤT KHO"));
    Serial.printf("| Kho hàng      : %-40s |\n", whName);
    Serial.printf("| Trạng thái    : %-40s |\n", status);
    Serial.println("+----------------------------------------------------------+");

    // Đánh giá trạng thái nghiệp vụ thực tế
    if (!strcmp(status, "approved")) {
      Serial.println("| => ĐÁNH GIÁ   : [HỢP LỆ] - ĐÃ ĐƯỢC QUẢN LÝ PHÊ DUYỆT!     |");
      Serial.println("| => HƯỚNG DẪN  : Sẵn sàng để thủ kho kiểm đếm thực tế!    |");
    } else if (!strcmp(status, "pending")) {
      Serial.println("| => ĐÁNH GIÁ   : [CHỜ DUYỆT] - Quản lý chưa phê duyệt!    |");
      Serial.println("| => HƯỚNG DẪN  : Thủ kho KHÔNG được phép xuất/nhập kho!   |");
    } else if (!strcmp(status, "rejected")) {
      Serial.println("| => ĐÁNH GIÁ   : [BỊ TỪ CHỐI] - Phiếu đã bị hủy bỏ!       |");
      Serial.println("| => HƯỚNG DẪN  : TỪ CHỐI THAO TÁC!                        |");
    } else if (!strcmp(status, "completed")) {
      Serial.println("| => ĐÁNH GIÁ   : [ĐÃ HOÀN TẤT] - Phiếu đã thực hiện rồi!  |");
      Serial.println("| => HƯỚNG DẪN  : Không thực hiện lặp lại!                 |");
    } else if (!strcmp(status, "draft")) {
      Serial.println("| => ĐÁNH GIÁ   : [BẢN NHÁP] - Phiếu chưa được gửi duyệt!  |");
    } else {
      Serial.printf("| => ĐÁNH GIÁ   : Trạng thái khác: %-23s |\n", status);
    }

    // Liệt kê danh sách sản phẩm trong phiếu
    Serial.println("+----------------------------------------------------------+");
    Serial.printf("| Chi tiết sản phẩm cần kiểm đếm (%u mặt hàng):             |\n", (unsigned int)items.size());
    for (size_t idx = 0; idx < items.size(); idx++) {
      const char *pName = items[idx]["product_name"] | "SanPham";
      int qty = items[idx]["quantity"] | 0;
      const char *sku = items[idx]["sku"] | "";
      Serial.printf("|  %u. %-24s [SKU: %-8s] x %-4d       |\n", (idx + 1), pName, sku, qty);
    }
    Serial.println("+----------------------------------------------------------+");
    Serial.println();

  } else if (httpCode == HTTP_CODE_NOT_FOUND) { // HTTP 404
    Serial.println();
    Serial.println("************************************************************");
    Serial.println("[KẾT QUẢ] KHÔNG TÌM THẤY PHIẾU KHO (HTTP 404)");
    Serial.printf("  Mã tra cứu: %s\n", identifier.c_str());
    Serial.println("  Lý do: Mã QR này không tồn tại trong cơ sở dữ liệu hệ thống.");
    Serial.println("************************************************************");

  } else if (httpCode == HTTP_CODE_UNAUTHORIZED) { // HTTP 401
    Serial.println();
    Serial.println("************************************************************");
    Serial.println("[KẾT QUẢ] LỖI XÁC THỰC THIẾT BỊ IOT (HTTP 401)");
    Serial.println("  Lý do: Khóa 'X-Device-Token' không khớp với Backend.");
    Serial.printf("  Khóa hiện tại trong config.h: %s\n", IOT_DEVICE_TOKEN);
    Serial.println("  Vui lòng kiểm tra lại biến IOT_DEVICE_TOKEN trong Backend/.env.");
    Serial.println("************************************************************");

  } else if (httpCode < 0) { // Lỗi kết nối mạng
    Serial.println();
    Serial.println("************************************************************");
    Serial.println("[KẾT QUẢ] LỖI KẾT NỐI ĐẾN BACKEND NODE.JS");
    Serial.printf("  Mã lỗi HTTPClient: %s (%d)\n", http.errorToString(httpCode).c_str(), httpCode);
    Serial.printf("  Địa chỉ cấu hình: http://%s:%d%s\n", BACKEND_HOST, BACKEND_PORT, BACKEND_API_BASE);
    Serial.println("  Hướng khắc phục:");
    Serial.println("    1. Kiểm tra Backend Node.js đã chạy chưa (npm run dev trong Backend).");
    Serial.println("    2. Kiểm tra địa chỉ IP trong config.h có đúng với IP máy tính (ipconfig).");
    Serial.println("    3. Tắt tường lửa Windows Firewall hoặc mở port 3000 cho mạng nội bộ.");
    Serial.println("************************************************************");

  } else {
    Serial.println();
    Serial.printf("[KẾT QUẢ] BACKEND PHẢN HỒI MÃ LỖI: %d\n", httpCode);
    Serial.println(http.getString());
  }

  http.end();
}

// ============================================================================
// HÀM MÃ HÓA URL (URL ENCODE)
// ============================================================================
String urlEncode(const String &str) {
  String encoded = "";
  char c;
  char code0;
  char code1;
  for (size_t i = 0; i < str.length(); i++) {
    c = str.charAt(i);
    if (isalnum(c) || c == '-' || c == '_' || c == '.' || c == '~') {
      encoded += c;
    } else {
      code0 = (c >> 4) & 0xf;
      code1 = c & 0xf;
      encoded += '%';
      encoded += (char)(code0 > 9 ? code0 - 10 + 'A' : code0 + '0');
      encoded += (char)(code1 > 9 ? code1 - 10 + 'A' : code1 + '0');
    }
  }
  return encoded;
}
