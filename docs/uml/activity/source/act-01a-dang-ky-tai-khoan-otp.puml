@startuml act-01a-dang-ky-tai-khoan-otp
title Sơ đồ hoạt động: Đăng ký tài khoản bằng Email OTP

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam wrapWidth 160
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityFontColor #111827
skinparam ActivityDiamondBorderColor #1E293B
skinparam ActivityDiamondBackgroundColor #F8FAFC
skinparam ArrowColor #1E293B
skinparam SwimlaneBorderColor #64748B
skinparam SwimlaneTitleBackgroundColor #F1F5F9
skinparam SwimlaneTitleFontColor #0F172A

|Khách hàng|
start
:Nhập họ tên, email\nvà mật khẩu;
|Giao diện Web/Mobile|
:Kiểm tra định dạng\ndữ liệu đầu vào;
if (Dữ liệu hợp lệ?) then ([Không])
  :Hiển thị thông báo\nlỗi nhập liệu;
  stop
else ([Có])
  :Gửi yêu cầu\ngửi mã OTP;
endif

|Backend API|
:Kiểm tra định dạng email;
|Cơ sở dữ liệu|
:Truy vấn kiểm tra\nemail đã tồn tại;
|Backend API|
if (Email hợp lệ và\nchưa đăng ký?) then ([Không])
  :Trả về lỗi 400 hoặc 409;
  |Giao diện Web/Mobile|
  :Hiển thị lỗi email;
  stop
else ([Có])
  :Sinh mã OTP 6 chữ số\nvà băm SHA-256;
endif

|Cơ sở dữ liệu|
:Vô hiệu hóa OTP cũ\nvà lưu OTP mới\n(hiệu lực 10 phút);
|Dịch vụ Email|
:Gửi email chứa mã OTP\n(Resend API / SMTP);
|Giao diện Web/Mobile|
:Chuyển sang bước\nnhập mã OTP;

|Khách hàng|
:Nhập mã OTP 6 số\nvà nhấn xác nhận;
|Giao diện Web/Mobile|
:Gửi yêu cầu đăng ký\nkèm mã OTP;

|Backend API|
:Bắt đầu giao dịch\nđăng ký;
|Cơ sở dữ liệu|
:Khóa và đọc bản ghi\nOTP mới nhất;
|Backend API|
if (OTP hợp lệ, chưa hết hạn,\n<= 5 lần thử và khớp mã?) then ([Không])
  |Cơ sở dữ liệu|
  :Tăng số lần thử sai (nếu có)\nvà kết thúc giao dịch;
  |Backend API|
  :Trả về lỗi 400 hoặc 409;
  |Giao diện Web/Mobile|
  :Hiển thị thông báo\nOTP không hợp lệ;
  stop
else ([Có])
  |Cơ sở dữ liệu|
  :Đánh dấu OTP đã xác thực;
  :Băm mật khẩu (scrypt) và\ntạo tài khoản (customer);
  |Backend API|
  :Ký JWT HS256 (hạn 7 ngày)\nvà trả về HTTP 201;
  |Giao diện Web/Mobile|
  :Lưu phiên đăng nhập và\nchuyển vào trang Cửa hàng;
  stop
endif
@enduml
