@startuml act-03-dat-hang-online-va-thanh-toan
title Sơ đồ hoạt động: Đặt hàng trực tuyến, Giữ chỗ tồn kho và Đối soát VietQR

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam wrapWidth 165
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityFontColor #111827
skinparam ActivityDiamondBorderColor #1E293B
skinparam ActivityDiamondBackgroundColor #F8FAFC
skinparam ArrowColor #1E293B
skinparam SwimlaneBorderColor #64748B
skinparam SwimlaneTitleBackgroundColor #F1F5F9
skinparam SwimlaneTitleFontColor #0F172A

|Khách hàng|
start
:Chọn địa chỉ, phương thức\n(COD / Chuyển khoản) và Đặt hàng;
|Giao diện Mua hàng|
:Gửi yêu cầu đặt hàng\n(kèm khóa chống trùng lặp);

|Backend API|
:Xác thực JWT và quyền đặt hàng;
:Bắt đầu giao dịch CSDL;
|Cơ sở dữ liệu|
:Kiểm tra khóa trùng lặp, kho,\ngiỏ hàng, sản phẩm và địa chỉ;
|Backend API|
if (Giỏ hàng, địa chỉ\nvà sản phẩm hợp lệ?) then ([Không])
  |Cơ sở dữ liệu|
  :Hoàn tác giao dịch;
  |Backend API|
  :Trả về lỗi 400 hoặc 409;
  |Giao diện Mua hàng|
  :Hiển thị lỗi đặt hàng;
  stop
else ([Có])
  |Cơ sở dữ liệu|
  :Tạo đơn hàng (pending)\nvà lưu chi tiết dòng hàng;
  :Khóa dòng tồn kho để\nkiểm tra tồn khả dụng;
  |Backend API|
  if (Đủ tồn khả dụng?) then ([Không đủ])
    |Cơ sở dữ liệu|
    :Hoàn tác giao dịch;
    |Backend API|
    :Trả về lỗi 409 Conflict;
    |Giao diện Mua hàng|
    :Thông báo hết hàng khả dụng;
    stop
  else ([Đủ])
    |Cơ sở dữ liệu|
    :Tăng lượng giữ chỗ và tạo\nbản ghi giữ chỗ (active);
    :Ghi lịch sử, xóa giỏ hàng\nvà xác nhận giao dịch;
    |Backend API|
    :Trả về HTTP 201 kèm đơn hàng;
  endif
endif

|Giao diện Mua hàng|
if (Phương thức thanh toán?) then ([Chuyển khoản VietQR])
  :Hiển thị mã QR VietQR;
  |Khách hàng|
  :Chuyển khoản và gửi\nmã tham chiếu giao dịch;
  |Cơ sở dữ liệu|
  :Kiểm tra đơn và lưu yêu cầu\nđối soát (pending);
  |Backend API|
  :Trả về HTTP 201;

  |Kế toán / Quản lý|
  :Đối chiếu sao kê và duyệt;
  |Cơ sở dữ liệu|
  :Khóa yêu cầu và đơn hàng;
  |Backend API|
  if (Hợp lệ, đúng số tiền\nvà chưa trùng mã?) then ([Không])
    |Cơ sở dữ liệu|
    :Hoàn tác giao dịch;
    |Backend API|
    :Trả về lỗi 404 hoặc 409;
    stop
  else ([Có])
    |Cơ sở dữ liệu|
    :Lưu thanh toán, cập nhật paid,\ngỡ hạn giữ chỗ và xác nhận;
    |Backend API|
    :Trả về HTTP 200;
  endif
else ([COD])
  :Hiển thị đơn hàng chờ xử lý;
endif

stop
@enduml
