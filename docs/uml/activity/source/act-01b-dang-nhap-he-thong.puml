@startuml act-01b-dang-nhap-he-thong
title Sơ đồ hoạt động: Đăng nhập và Phân quyền hệ thống

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam wrapWidth 160
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityFontColor #111827
skinparam ActivityDiamondBorderColor #1E293B
skinparam ActivityDiamondBackgroundColor #F8FAFC
skinparam ArrowColor #1E293B
skinparam SwimlaneBorderColor #64748B
skinparam SwimlaneTitleBackgroundColor #F1F5F9
skinparam SwimlaneTitleFontColor #0F172A

|Người dùng|
start
:Nhập email và mật khẩu;
|Giao diện Web/Mobile|
:Gửi yêu cầu đăng nhập;

|Backend API|
:Kiểm tra dữ liệu đầu vào;
|Cơ sở dữ liệu|
:Truy vấn thông tin tài khoản,\nvai trò, quyền hạn và kho;
|Backend API|
if (Tài khoản tồn tại và\nđúng mật khẩu scrypt?) then ([Không])
  :Trả về lỗi 401 Unauthorized;
  |Giao diện Web/Mobile|
  :Hiển thị lỗi sai\nthông tin đăng nhập;
  stop
else ([Đúng])
  if (Tài khoản đang\nhoạt động?) then ([Bị khóa])
    :Trả về lỗi 403 Forbidden;
    |Giao diện Web/Mobile|
    :Hiển thị thông báo\ntài khoản bị khóa;
    stop
  else ([Hoạt động])
    :Ký mã thông báo JWT HS256\n(hạn 7 ngày);
    :Trả về HTTP 200 kèm\ntoken và danh sách quyền;
    |Giao diện Web/Mobile|
    :Lưu token vào phiên làm việc\nvà điều hướng theo vai trò;
    stop
  endif
endif
@enduml
