@startuml act-05-xu-ly-don-dong-goi-giao-nhan
title Sơ đồ hoạt động: Xử lý đơn hàng, Đóng gói và Giao nhận vận chuyển

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam ActivityBorderColor #1E293B
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityFontColor #111827
skinparam ActivityDiamondBorderColor #1E293B
skinparam ActivityDiamondBackgroundColor #F8FAFC
skinparam ArrowColor #1E293B
skinparam SwimlaneBorderColor #64748B
skinparam SwimlaneTitleBackgroundColor #F1F5F9
skinparam SwimlaneTitleFontColor #0F172A

|Quản lý|
start
:Xem đơn hàng trực tuyến (pending) và nhấn Xác nhận;
|Backend API|
|Cơ sở dữ liệu|
:Chuyển trạng thái đơn pending -> confirmed\nvà tạo tác vụ xử lý đơn;
|Backend API|
:Trả về mã HTTP 200;

|Nhân viên xử lý / Kho|
:Nhận đơn và chuyển sang Sẵn sàng đóng gói;
|Backend API|
|Cơ sở dữ liệu|
:Chuyển trạng thái đơn confirmed -> ready_to_pack;
|Backend API|
:Trả về mã HTTP 200;

|Nhân viên xử lý / Kho|
:Quét kiểm tra đủ SKU/số lượng và nhấn Đóng gói;
|Backend API|
:Bắt đầu giao dịch đóng gói đơn hàng;
|Cơ sở dữ liệu|
:Kiểm tra trạng thái ready_to_pack và khóa các bản ghi giữ chỗ;
|Backend API|
if (Tất cả giữ chỗ ở trạng thái active và đủ tồn?) then ([Không hợp lệ])
  |Cơ sở dữ liệu|
  :Hoàn tác giao dịch;
  |Backend API|
  :Trả về lỗi 409 Conflict;
  stop
else ([Hợp lệ])
  |Cơ sở dữ liệu|
  :Trừ tồn thực tế và lượng giữ chỗ, đóng giữ chỗ (consumed)\nvà ghi sổ biến động kho;
  :Chuyển trạng thái đơn ready_to_pack -> packed\nvà xác nhận giao dịch;
  |Backend API|
  :Trả về mã HTTP 200;
endif

|Quản lý|
:Tạo vận đơn và gán Shipper phụ trách;
|Backend API|
|Cơ sở dữ liệu|
:Tạo bản ghi vận đơn (assigned)\nvà chuyển trạng thái đơn packed -> handover;
|Backend API|
:Trả về mã HTTP 201;

|Shipper|
:Quét nhận bàn giao và bắt đầu vận chuyển;
|Backend API|
|Cơ sở dữ liệu|
:Cập nhật vận đơn và chuyển đơn handover -> shipping;
|Shipper|
:Thực hiện giao hàng cho khách;
if (Kết quả giao hàng?) then ([Giao thành công])
  |Backend API|
  |Cơ sở dữ liệu|
  :Cập nhật vận đơn và chuyển đơn shipping -> delivered;
else ([Khách từ chối / Hoàn trả])
  |Backend API|
  |Cơ sở dữ liệu|
  :Cập nhật vận đơn và chuyển đơn shipping -> returned;
endif
|Backend API|
:Trả về mã HTTP 200;
stop
@enduml
