@startuml
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center

skinparam actor {
  FontSize 13
  FontColor #1E293B
  BorderColor #334155
  BackgroundColor #F8FAFC
}

skinparam usecase {
  FontSize 12
  FontColor #0F172A
  BackgroundColor #EFF6FF
  BorderColor #1E40AF
  BorderThickness 1.3
}

skinparam rectangle {
  FontSize 14
  FontStyle bold
  FontColor #0F172A
  BorderColor #334155
  BorderThickness 1.5
  BackgroundColor #FFFFFF
}

skinparam ArrowColor #334155
skinparam ArrowThickness 1.1
skinparam ArrowFontSize 11
skinparam ArrowFontColor #1E293B
skinparam Padding 5
skinparam nodesep 30
skinparam ranksep 85

together {
  actor "Nhân viên kho" as ACT_WH
  actor "Camera IoT\nESP32-S3" as ACT_IOT <<Thiết bị>>
}

rectangle "Phân hệ Nhập kho, Xuất kho và Đối soát QR/IoT (Karat Retail)" as SYS {
  together {
    usecase "Lập phiếu\nyêu cầu\nnhập kho" as UC_WH_01
    usecase "Lập phiếu\nyêu cầu\nxuất kho" as UC_WH_02
    usecase "Tra cứu và\nxem chi tiết\nchứng từ kho" as UC_WH_03
    usecase "Phê duyệt phiếu\nvà sinh mã QR\nđối soát" as UC_WH_04
    usecase "Từ chối\nyêu cầu\nnhập xuất kho" as UC_WH_05
    usecase "Đồng bộ cấu hình\nWi-Fi và trạng thái\nCamera IoT" as UC_WH_09
    usecase "Xác nhận hoàn tất\nnhập xuất và\ncập nhật tồn" as UC_WH_08
  }
  together {
    usecase "Quét mã QR\nphiếu kho\nđối soát" as UC_WH_06
    usecase "Quét mã SKU\nkiểm đếm dòng\nhàng trong phiếu" as UC_WH_07
  }
}

together {
  actor "Quản lý" as ACT_MGR
  actor "Quản trị viên" as ACT_ADM
}

' Kế thừa Actor: Quản trị viên kế thừa toàn bộ quyền của Quản lý
ACT_ADM -up-|> ACT_MGR

' Nhân viên kho tác nghiệp chứng từ kho
ACT_WH -- UC_WH_01
ACT_WH -- UC_WH_02
ACT_WH -- UC_WH_03
ACT_WH -- UC_WH_06
ACT_WH -- UC_WH_07
ACT_WH -- UC_WH_08

' Camera IoT ESP32-S3 quét QR phiếu kho & gửi heartbeat đồng bộ Wi-Fi
ACT_IOT -- UC_WH_06
ACT_IOT -- UC_WH_09

' Quản lý (và Quản trị viên kế thừa) lập đề xuất, xét duyệt phiếu và quản lý trạm IoT
UC_WH_01 -- ACT_MGR
UC_WH_03 -- ACT_MGR
UC_WH_04 -- ACT_MGR
UC_WH_05 -- ACT_MGR
UC_WH_06 -- ACT_MGR
UC_WH_09 -- ACT_MGR

' Admin có thêm quyền warehouse.documents.create & complete
UC_WH_02 -- ACT_ADM
UC_WH_07 -- ACT_ADM
UC_WH_08 -- ACT_ADM

' Quan hệ <<include>> bắt buộc (warehouse.model.js dòng 254): phải có qr_scanned_at trước khi completeDocument
UC_WH_08 ..> UC_WH_06 : <<include>>

' Quan hệ <<extend>> có điều kiện (warehouse.model.js dòng 281): quét SKU từng dòng khi bật require_scan
UC_WH_07 .left.> UC_WH_08 : <<extend>>

@enduml
