@startuml
left to right direction

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Arial"
skinparam defaultTextAlignment center

skinparam actor {
  FontSize 13
  FontColor #1E293B
  BorderColor #334155
  BackgroundColor #F8FAFC
}

skinparam usecase {
  FontSize 12
  FontColor #0F172A
  BackgroundColor #EFF6FF
  BorderColor #1E40AF
  BorderThickness 1.3
}

skinparam rectangle {
  FontSize 14
  FontStyle bold
  FontColor #0F172A
  BorderColor #334155
  BorderThickness 1.5
  BackgroundColor #FFFFFF
}

skinparam ArrowColor #334155
skinparam ArrowThickness 1.1
skinparam ArrowFontSize 11
skinparam ArrowFontColor #1E293B
skinparam Padding 5
skinparam nodesep 32
skinparam ranksep 95

together {
  actor "Quản trị viên" as ACT_ADM
  actor "Quản lý" as ACT_MGR
}

rectangle "Phân hệ AI Dự báo Nhu cầu, Báo cáo & Trao đổi Dữ liệu (Karat Retail)" as SYS {
  together {
    usecase "Xem cảnh báo\nnguy cơ thiếu hàng\ntheo dự báo" as UC_RPT_03
    usecase "Khởi chạy\nmô hình dự báo\nnhu cầu AI" as UC_RPT_01
    usecase "Xem kết quả\nvà chỉ số đánh giá\ndự báo (MAE/RMSE)" as UC_RPT_02
    usecase "Xem bảng\ntổng quan\nkinh doanh" as UC_RPT_05
    usecase "Xem báo cáo\ndoanh thu đa kênh\nvà theo ngày" as UC_RPT_06
    usecase "Nhập dữ liệu\nhàng loạt từ file\nExcel / CSV" as UC_RPT_07
    usecase "Xuất dữ liệu\nvà báo cáo ra\nExcel / CSV" as UC_RPT_08
    usecase "Tra cứu lịch sử\ntác vụ nhập xuất\ndữ liệu" as UC_RPT_09
  }
  usecase "Lập phiếu nhập\nđề xuất tự động\ntừ dự báo AI" as UC_RPT_04
}

actor "Dịch vụ AI\nDự báo nhu cầu" as ACT_AI <<Hệ thống ngoài>>

' Kế thừa Actor
ACT_ADM --|> ACT_MGR

' Associations bên trái
ACT_MGR -- UC_RPT_03
ACT_MGR -- UC_RPT_04
ACT_MGR -- UC_RPT_01
ACT_MGR -- UC_RPT_02
ACT_MGR -- UC_RPT_05
ACT_MGR -- UC_RPT_06
ACT_MGR -- UC_RPT_07
ACT_MGR -- UC_RPT_08
ACT_MGR -- UC_RPT_09

' Tích hợp sang dịch vụ Python FastAPI LightGBM (/forecast) đặt bên phải System Boundary
UC_RPT_01 --- ACT_AI

' Quan hệ <<extend>> sang cột phụ bên phải để nhãn <<extend>> nằm thoáng trên đường ngang
UC_RPT_03 <.. UC_RPT_04 : <<extend>>

@enduml
